# 可选的单模型兼容档案。正式多模型配置请使用界面的“模型设置”；
# 每次聊天、解释、翻译和图谱请求都以聊天框当前选择的模型档案为准。
PAPER_AGENT_REASONING_BASE_URL=http://127.0.0.1:8001/v1
PAPER_AGENT_REASONING_MODEL=your-served-model
# 本地 vLLM 通常可用 EMPTY；如服务要求密钥，请只在本机环境中配置，不要提交真实值。
PAPER_AGENT_REASONING_API_KEY=EMPTY

# search_paper 语义检索的嵌入模型（paperqa2 本地栈，st- 前缀 = sentence-transformers）。
# 默认多语言模型支持中文提问检索英文论文；首次使用会从 HuggingFace 下载（约 100-500MB，之后离线）。
# 国内网络可加：HF_ENDPOINT=https://hf-mirror.com
PAPER_AGENT_EMBEDDING_MODEL=st-paraphrase-multilingual-MiniLM-L12-v2
